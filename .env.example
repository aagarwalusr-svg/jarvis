# Copy to .env in the repository root. Never commit real keys.
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=jarvis
DATABASE_URL=postgresql+asyncpg://jarvis:change-this-local-password@localhost:5432/jarvis
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro
# Optional bearer token to protect the backend. Enter it in the dashboard settings.
JARVIS_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Frontend variables go in frontend/.env.local; defaults work locally.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Auto routing uses these model IDs. Override to match your account.
OPENAI_MODEL=gpt-4.1-mini
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
# Auto mode may resend chat context to another configured provider after a failure.
AUTO_FALLBACK=true
